{
  "version": 2,
  "rewrites": [
    {
      "source": "/feed",
      "destination": "/podcast.xml"
    },
    {
      "source": "/rss",
      "destination": "/podcast.xml"
    }
  ],
  "headers": [
    {
      "source": "/(podcast.xml|feed|rss)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/rss+xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "cleanUrls": true
}
